# Copy to .env (or export in your shell).
# Without GEMINI_API_KEY, RootCause runs fully offline: KeywordGrader
# instead of GeminiGrader, RAG search returns raw retrieved summaries
# instead of an LLM-generated answer, and AI-powered diagnosis explanations
# are simply omitted (lesson_summary/lesson_key_points are always present).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Without DATABASE_URL, uses a local sqlite file (./rootcause.db) -- zero
# config, perfect for local dev. Set this to a real Postgres URL in
# production (Render/Railway/Supabase all hand you one):
#   postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Change this before deploying anywhere real -- it signs every login token.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_SECONDS=604800
